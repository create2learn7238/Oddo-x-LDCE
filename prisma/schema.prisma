generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  photo     String?
  language  String    @default("en")
  isAdmin   Boolean   @default(false)
  createdAt DateTime  @default(now())
  trips     Trip[]
  savedCities City[]  @relation("SavedCities")
}

model City {
  id          String     @id @default(cuid())
  name        String
  country     String
  region      String
  costIndex   Int        // 1..5 (1 = budget, 5 = luxury)
  popularity  Int        // 1..100
  description String
  emoji       String     @default("🏙️")
  color       String     @default("#6366f1")
  lat         Float
  lng         Float
  savedBy     User[]     @relation("SavedCities")
  stops       Stop[]
  activities  Activity[]

  @@unique([name, country])
}

model Trip {
  id          String     @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  coverEmoji  String     @default("")
  coverColor  String     @default("#6366f1")
  coverImage  String?
  budgetTotal Int?       // user-set budget in USD
  isPublic    Boolean    @default(false)
  shareToken  String?    @unique
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops       Stop[]
  createdAt   DateTime   @default(now())
}

model Stop {
  id            String         @id @default(cuid())
  tripId        String
  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cityId        String
  city          City           @relation(fields: [cityId], references: [id])
  arrivalDate   DateTime
  departureDate DateTime
  notes         String?
  sequence      Int            @default(0)
  activities    StopActivity[]
}

model Activity {
  id          String         @id @default(cuid())
  cityId      String
  city        City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name        String
  type        String         // sightseeing | food | culture | adventure | shopping | nightlife | outdoors
  duration    Int            // hours
  cost        Int            // USD per person
  description String
  emoji       String
  assignments StopActivity[]
}

model StopActivity {
  id         String   @id @default(cuid())
  stopId     String
  stop       Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  dayOffset  Int      @default(0) // 0-based day within the stop
  startTime  String?  // "HH:mm"
  cost       Int      @default(0) // per-person cost snapshot
}
